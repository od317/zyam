generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Language {
  ar
  en
}

enum PriceMode {
  exact
  range
  hidden
  on_request
}

enum ImageStatus {
  processing
  ready
  failed
}

model Service {
  id           Int                  @id @default(autoincrement())
  slug         String               @unique
  translations ServiceTranslation[]
  projects     Project[]
}

model ServiceTranslation {
  id          Int      @id @default(autoincrement())
  serviceId   Int
  service     Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  language    Language
  name        String
  description String

  @@unique([serviceId, language])
}

model Project {
  id             Int                  @id @default(autoincrement())
  slug           String               @unique
  serviceId      Int
  service        Service              @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  year           Int?
  durationMonths Int?
  isPublished    Boolean              @default(false)
  priceMode      PriceMode            @default(on_request)
  priceMin       Decimal?             @db.Decimal(12, 2)
  priceMax       Decimal?             @db.Decimal(12, 2)
  inquiries      Inquiry[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  translations   ProjectTranslation[]
  images         ProjectImage[]
  deletedAt      DateTime?

  @@index([isPublished, createdAt])
}

model ProjectTranslation {
  id          Int      @id @default(autoincrement())
  projectId   Int
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  language    Language
  title       String
  description String
  city        String?

  @@unique([projectId, language])
}

model ProjectImage {
  id        Int         @id @default(autoincrement())
  projectId Int
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sortOrder Int
  status    ImageStatus @default(processing)
  width     Int?
  height    Int?
  thumbUrl  String?
  mediumUrl String?
  largeUrl  String?
  originalKey String
  blurDataUrl String?
  attempts    Int       @default(0)
  lastError   String?
  lockedAt    DateTime?
  createdAt   DateTime  @default(now())

  @@index([status, createdAt])
  @@unique([projectId, sortOrder])
}

enum InquiryType {
  consultation
  project_idea
  quote_request
}

enum InquiryStatus {
  new
  contacted
  closed
}

model Inquiry {
  id        Int            @id @default(autoincrement())
  type      InquiryType
  status    InquiryStatus  @default(new)
  name      String
  phone     String
  email     String?
  title     String?
  message   String
  projectId Int?
  project   Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  adminNote String?
  images    InquiryImage[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([status, createdAt])
}

model InquiryImage {
  id        Int      @id @default(autoincrement())
  inquiryId Int
  inquiry   Inquiry  @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  url       String
  createdAt DateTime @default(now())
}

enum Role {
  admin
  editor
}

model User {
  id            Int            @id @default(autoincrement())
  email         String         @unique
  name          String
  passwordHash  String
  role          Role           @default(editor)
  isActive      Boolean        @default(true)
  otpSecret     String?
  otpEnabled    Boolean        @default(false)
  lastLoginAt   DateTime?
  pendingLogins PendingLogin[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  sessions      Session[]
  backupCodes   BackupCode[]
  auditLogs     AuditLog[]
}

model Session {
  id        String   @id
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  ip        String?
  userAgent String?

  @@index([userId])
  @@index([expiresAt])
}

model BackupCode {
  id       Int       @id @default(autoincrement())
  userId   Int
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash String
  usedAt   DateTime?

  @@index([userId])
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  userId     Int?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   Int?
  details    Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

model RateLimit {
  key         String   @id
  count       Int      @default(0)
  windowStart DateTime
}

model PendingLogin {
  id        String   @id // hash of the pending token, like Session.id
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}
